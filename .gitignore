# Local Google Fonts TTF cache for the diploma renderer.
# Populated by bin/download_diploma_fonts.php (or manually with bin/copy_fonts.sh
# + a git clone of https://github.com/google/fonts).
local/grupomakro_core/tcpdf_fonts/

# Throwaway diagnostic scripts and SQL dumps. Safe to delete locally.
tmp/

# Throwaway CLI one-off diagnostics (e.g. ad-hoc SQL probes). Don't commit
# these; rerun via cli/ snapshots / debug paths instead.
cli/diagnostic_*.php